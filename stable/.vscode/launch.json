{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Kernel (QEMU)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/kernel/kernel.elf",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Explicitly load symbols from the ELF file",
          "text": "file ${workspaceFolder}/kernel/kernel.elf",
          "ignoreFailures": false
        },
        {
          "description": "Set architecture",
          "text": "set architecture i386",
          "ignoreFailures": false
        },
        {
          "description": "Connect to QEMU manually (guarantees order)",
          "text": "target remote localhost:1234",
          "ignoreFailures": false
        }
        // ,
        // {
	 			// 	"description": "Break at kernel's kernel_main()",
	 			// 	"text": "break kernel_main",
	 			// 	"ignoreFailures": false
        // }
      ],
      "launchCompleteCommand": "None",
      "logging": {
        "engineLogging": true
      }
    }
  ]
}
